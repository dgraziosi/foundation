# Required. Send as: Authorization: ApiKey <FOUNDATION_API_KEY>
# Bearer <FOUNDATION_API_KEY> is accepted as an equivalent.
FOUNDATION_API_KEY=change-me-to-a-long-random-string

# Host-side URL when running the app on the machine (Compose db publishes 5432).
# The foundation Compose service uses postgres://foundation:foundation@db:5432/foundation instead.
DATABASE_URL=postgres://foundation:foundation@localhost:5432/foundation

# This vault: durable files (Postgres volume + blobs/ + uploads/). Never point this at an agent profile/memory dir.
FOUNDATION_DATA=./data

# Optional. Numeric uid of the user who runs Compose. Default: owner of docker-compose.yml in the clone.
# FOUNDATION_HOST_UID=

# Optional. Default is a sibling of FOUNDATION_DATA (./foundation-backups when FOUNDATION_DATA is ./data).
# Never set this inside FOUNDATION_DATA. Nightly backup: scripts/backup-vault.sh
# BACKUP_ROOT=./foundation-backups

# MCP, health, and agent blobs. Compose publishes this on localhost only.
PORT=8787

# User window. Compose publishes this on all interfaces (`http://<this-host>:8788/view`).
VIEW_PORT=8788

# Optional override for `pnpm bootstrap` (defaults to http://127.0.0.1:$PORT/mcp)
# FOUNDATION_MCP_URL=http://127.0.0.1:8787/mcp
