# Required. Bootstrap / root key. Send as: Authorization: ApiKey <FOUNDATION_API_KEY>
# Bearer is accepted as an equivalent. Mint more keys with scripts/mint-api-key.sh
# (hashes land in $FOUNDATION_DATA/api-keys.json; never commit secrets).
FOUNDATION_API_KEY=change-me-to-a-long-random-string
# Optional label stamped on activity for the bootstrap key (default: root).
# FOUNDATION_API_KEY_LABEL=root

# Optional. Vault key the person types to open the window.
# When set, MCP keys (FOUNDATION_API_KEY and named keys) do not open /view.
# Leave unset and the house key still opens the window. A leaked bot key
# then still opens the window — set the view key.
# FOUNDATION_VIEW_KEY=

# Host Postgres on this machine. One data folder. Backup and the app both see it.
DATABASE_URL=postgres://foundation:change-me-to-a-password@localhost:5432/foundation

# This vault: durable files (postgres/ + blobs/ + uploads/). Never point this at an agent profile/memory dir.
FOUNDATION_DATA=./data

# Optional. Default is a sibling of FOUNDATION_DATA (./foundation-backups when FOUNDATION_DATA is ./data).
# Never set this inside FOUNDATION_DATA. Nightly dump is a host cron/script: scripts/backup-vault.sh
# BACKUP_ROOT=./foundation-backups
# BACKUP_AGE_RECIPIENT=
# BACKUP_AGE_IDENTITY=
# BACKUP_KEEP_DAYS=14
# BACKUP_OFFSITE=

# MCP, health, and agent blobs. Bind localhost only.
PORT=8787

# User window. Bind localhost only (`http://127.0.0.1:8788/view`).
# Off-box: VIEW_HOST=0.0.0.0
VIEW_PORT=8788

# Optional override for `pnpm bootstrap` (defaults to http://127.0.0.1:$PORT/mcp)
# FOUNDATION_MCP_URL=http://127.0.0.1:8787/mcp
