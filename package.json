{
  "name": "foundation",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r typecheck",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && bash scripts/backup-vault.test.sh && bash scripts/harness-docs.test.sh",
    "dev": "pnpm --filter @foundation/server dev",
    "start": "pnpm --filter @foundation/server start",
    "bootstrap": "pnpm --filter @foundation/server bootstrap"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
