<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>foundation.keep-vault-up</string>
	<key>WorkingDirectory</key>
	<string>/path/to/the/clone</string>
	<key>ProgramArguments</key>
	<array>
		<string>/path/to/the/clone/scripts/keep-vault-up.sh</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
	</dict>
	<key>StartInterval</key>
	<integer>900</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/tmp/foundation-keep-vault-up.out</string>
	<key>StandardErrorPath</key>
	<string>/tmp/foundation-keep-vault-up.err</string>
</dict>
</plist>
